FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Отдельный набор зависимостей MAX (maxapi несовместим с aiogram по aiohttp).
COPY requirements-max.txt .
RUN pip install --upgrade pip && pip install -r requirements-max.txt

COPY . .

CMD ["python", "-m", "app.main_max"]
