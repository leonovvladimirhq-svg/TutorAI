# Все переменные окружения TutorAI. Скопируйте в .env и заполните.
# .env в git НЕ коммитится. Откуда брать значения — docs/SERVICES.md.

# ---- MAX (мессенджер) ----
# Токен бота от @MasterBot. Обязателен для сервиса bot_max.
MAX_BOT_TOKEN=
# Вебхук. Пусто — long-polling (проще локально, но голосовые НЕ доходят).
# Прод: https://<id>.apigw.yandexcloud.net/max/webhook (Yandex API Gateway → http://<vm>:8090/max/webhook)
MAX_WEBHOOK_URL=
# Секрет 5–256 символов: MAX присылает его в заголовке X-Max-Bot-Api-Secret, бот сверяет.
MAX_WEBHOOK_SECRET=
MAX_WEBHOOK_PORT=8090

# ---- База данных (контейнер db в docker-compose) ----
POSTGRES_USER=tutorai
POSTGRES_PASSWORD=
POSTGRES_DB=tutorai
# Внутри compose хост = db; локально без docker — localhost
DATABASE_URL=postgresql+asyncpg://tutorai:<POSTGRES_PASSWORD>@db:5432/tutorai

# ---- Yandex Cloud: LLM (AI Studio) и распознавание речи (SpeechKit) ----
# JSON-ключ сервисного аккаунта; файл кладётся в secrets/ (монтируется в контейнеры, вне git)
YC_SA_KEY_FILE=/secrets/sa-key.json
# ВАЖНО: каталог, где AI Studio примет запрос, — ДОМАШНИЙ каталог сервисного аккаунта,
# а не каталог VM (см. docs/SERVICES.md).
YC_FOLDER_ID=
LLM_ENDPOINT=https://llm.api.cloud.yandex.net/v1
# {folder} подставится из YC_FOLDER_ID
LLM_MODEL_URI=gpt://{folder}/qwen3-235b-a22b-fp8/latest
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=2000
ENABLE_VOICE=true
SPEECHKIT_STT_URL=https://stt.api.cloud.yandex.net/speech/v1/stt:recognize
SPEECHKIT_LANG=ru-RU

# ---- Веб-панель руководителя (http://<сервер>:WEB_PORT) ----
WEB_ADMIN_USER=academ
# Обязательно задайте свой сильный пароль: адрес панели и логин известны из публичного репозитория.
WEB_ADMIN_PASSWORD=
# Секрет подписи cookie-сессии — длинная случайная строка
WEB_SESSION_SECRET=
WEB_PORT=8080
# Опционально: MAX-ID, которому при старте выдаётся роль «Академический руководитель».
# Обычно не нужно — вход по кодам доступа из панели.
BOOTSTRAP_DIRECTOR_TG=

# ---- Оператор персональных данных (152-ФЗ) — подставляется в текст согласия ----
OPERATOR_NAME=Школа коммуникаций НИУ ВШЭ
# e-mail ответственного за обработку ПДн — заполнить до запуска со студентами
OPERATOR_EMAIL=
DATA_STORAGE=Yandex Cloud, ru-central1 (РФ, УЗ-1)

# ---- Мониторинг (опционально) ----
# Общий дашборд проектов команды. Пусто = телеметрия выключена.
# Уходят только категории действий и время обработки — без текстов, профилей, целей.
DASHBOARD_URL=
DASHBOARD_TOKEN=

# ---- Прочее ----
LOG_LEVEL=INFO

# ---- Telegram (LEGACY, не используется) ----
# Старая Telegram-версия (app/main.py, aiogram). Из Yandex Cloud Telegram заблокирован,
# бот переведён на MAX. Переменные оставлены, чтобы старый код запускался локально.
TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY=
