# ---- Telegram ----
TELEGRAM_BOT_TOKEN=000000:CHANGE_ME

# ---- Database ----
# Внутри docker-compose host = db; локально без docker — localhost
POSTGRES_USER=tutorai
POSTGRES_PASSWORD=change_me
POSTGRES_DB=tutorai
DATABASE_URL=postgresql+asyncpg://tutorai:change_me@db:5432/tutorai

# ---- Yandex Cloud / AI Studio ----
# Аутентификация AI-вызовов (LLM + SpeechKit) — Api-Key сервисного аккаунта.
# Создать: yc iam api-key create --service-account-id <SA_ID> (нужны scope ai.languageModels + speechkitStt)
YC_API_KEY=CHANGE_ME
# Путь к JSON сервисного аккаунта — только для деплой-инструментов (yc CLI), в runtime не нужен
YC_SA_KEY_FILE=/secrets/sa-key.json
# Каталог AI Studio/SpeechKit = ДОМАШНИЙ каталог сервисного аккаунта (иначе "folder does not match")
YC_FOLDER_ID=CHANGE_ME
# OpenAI-совместимый endpoint Yandex AI Studio
LLM_ENDPOINT=https://llm.api.cloud.yandex.net/v1
# URI модели; подставится folder_id вместо плейсхолдера {folder}.
# qwen3.6-35b-a3b — reasoning-модель (рассуждения в reasoning_content, ответ в content).
LLM_MODEL_URI=gpt://{folder}/qwen3.6-35b-a3b/latest
LLM_TEMPERATURE=0.4
# Высокий лимит: reasoning-модель тратит ~1.5к токенов на «мышление» сверх ответа
LLM_MAX_TOKENS=4000

# ---- SpeechKit (STT) ----
ENABLE_VOICE=true
SPEECHKIT_STT_URL=https://stt.api.cloud.yandex.net/speech/v1/stt:recognize
SPEECHKIT_LANG=ru-RU

# ---- App ----
LOG_LEVEL=INFO
